FROM python:3.12.16-slim-trixie AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    APP_ENVIRONMENT=production \
    PORT=8000

WORKDIR /opt/pouktry
COPY backend/ /opt/pouktry/backend/
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir /opt/pouktry/backend \
    && groupadd --system --gid 10001 pouktry \
    && useradd --system --uid 10001 --gid pouktry --home-dir /nonexistent pouktry

ENV PYTHONPATH=/opt/pouktry/backend
USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "from urllib.request import urlopen; urlopen('http://127.0.0.1:8000/health', timeout=3)" || exit 1

CMD ["sh", "-c", "uvicorn app.main:app --app-dir backend --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers"]
