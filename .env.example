APP_ENVIRONMENT=development
LOG_LEVEL=INFO
POSTGRES_DB=pouktry
POSTGRES_USER=pouktry
POSTGRES_PASSWORD=replace_me_local_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://pouktry:replace_me_local_only@localhost:5432/pouktry
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
JWT_ISSUER=pouktry-api
JWT_AUDIENCE=pouktry-client
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_DAYS=14
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
FRONTEND_ORIGIN=http://localhost:5173
